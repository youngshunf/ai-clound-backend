# [ Marketplace ] GitHub 同步配置
HUANXING_HUB_REPO_URL='https://github.com/youngshunf/huanxing-hub.git'
HUANXING_HUB_LOCAL_PATH='/tmp/huanxing-hub'
GITHUB_WEBHOOK_SECRET='your-webhook-secret-here'
MARKETPLACE_CACHE_DIR='/tmp/marketplace-cache'

# [ new-api ] 管理 API 配置
# 2026-06-15 new-api 解耦后，登录会通过该管理通道确保用户 LLM token。
# 生产必填：使用 new-api root/admin 用户生成的 access_token；空值会导致登录时报
# “LLM 服务初始化失败”（new-api /api/user/search 返回 401）。
NEWAPI_ADMIN_BASE_URL='http://localhost:3180/api'
NEWAPI_ADMIN_ACCESS_TOKEN=''
NEWAPI_ADMIN_USER_ID=1
NEWAPI_HTTP_TIMEOUT_SECONDS=15
NEWAPI_QUOTA_PER_DOLLAR=500000
NEWAPI_REGISTER_BONUS_CREDITS=100
