# Env
ENVIRONMENT='dev'
# Database
DATABASE_TYPE='postgresql'
DATABASE_HOST='127.0.0.1'
DATABASE_PORT=5432
DATABASE_USER='postgres'
DATABASE_PASSWORD='123456'
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=2
# Redis
REDIS_HOST='127.0.0.1'
REDIS_PORT=6379
REDIS_PASSWORD=''
REDIS_DATABASE=0
# Redis 6 兼容阶段使用 RESP2 + Lua；Redis 8 蓝绿验收后显式切为 3 + lmove
REDIS_PROTOCOL=2
REDIS_LIST_MOVE_MODE='lua'
# Token
TOKEN_SECRET_KEY='1VkVF75nsNABBjK_7-qz7GtzNy3AMvktc9TCPwKczCk'
# [ App ] task
# Celery
CELERY_BROKER_REDIS_DATABASE=1
CELERY_BROKER='redis'
# 容器/进程环境注入时使用，避免与 Celery CLI 的 CELERY_BROKER URL 变量冲突
CELERY_BROKER_MODE='inherit'
# Rabbitmq
CELERY_RABBITMQ_HOST='127.0.0.1'
CELERY_RABBITMQ_PORT=5672
CELERY_RABBITMQ_VHOST='huanxing'
CELERY_RABBITMQ_USERNAME=''
CELERY_RABBITMQ_PASSWORD=''
# Flower 必须使用至少 24 位密码的 username:password；仅在启用 Flower 时填写
FLOWER_BASIC_AUTH=''
# Socket.IO / HASN realtime / offline recovery
SOCKETIO_MANAGER='redis'
REALTIME_RABBITMQ_HOST='127.0.0.1'
REALTIME_RABBITMQ_PORT=5672
REALTIME_RABBITMQ_VHOST='huanxing'
REALTIME_RABBITMQ_USERNAME=''
REALTIME_RABBITMQ_PASSWORD=''
HASN_REALTIME_BUS='redis'
HASN_REALTIME_SHADOW_RABBITMQ=false
HASN_OFFLINE_RECOVERY='redis'
# [ Plugin ] oauth2
OAUTH2_GITHUB_CLIENT_ID='test'
OAUTH2_GITHUB_CLIENT_SECRET='test'
OAUTH2_GOOGLE_CLIENT_ID='test'
OAUTH2_GOOGLE_CLIENT_SECRET='test'
# [ Plugin ] email
EMAIL_USERNAME=''
EMAIL_PASSWORD=''
# [ Marketplace ] GitHub 同步配置
HUANXING_HUB_REPO_URL='https://github.com/youngshunf/hasn-hub.git'
HUANXING_HUB_LOCAL_PATH='/tmp/hasn-hub'
GITHUB_WEBHOOK_SECRET='your-webhook-secret-here'
MARKETPLACE_CACHE_DIR='/tmp/marketplace-cache'

# [ new-api ] 管理 API 配置
# 2026-06-15 new-api 解耦后，登录会通过该管理通道确保用户 LLM token。
# 生产必填：使用 new-api root/admin 用户生成的 access_token；空值会导致登录时报
# “LLM 服务初始化失败”（new-api /api/user/search 返回 401）。
NEWAPI_ADMIN_BASE_URL='http://localhost:3180/api'
NEWAPI_ADMIN_ACCESS_TOKEN=''
NEWAPI_ADMIN_USER_ID=1
NEWAPI_HTTP_TIMEOUT_SECONDS=15
NEWAPI_QUOTA_PER_DOLLAR=500000
NEWAPI_REGISTER_BONUS_CREDITS=100
# [ App ] hasn_growth 项目化 v4
# 全部默认关闭；生产开启必须经变更审计。企业 ID 映射完成前不得开启企业模式。
GROWTH_PROJECT_V4_ENABLED=false
GROWTH_PROJECT_V4_ENTERPRISE_ENABLED=false
GROWTH_PII_NEW_WRITE_ENABLED=false
GROWTH_PII_SHADOW_READ_ENABLED=false
# 真实值由 Vault/KMS 注入；加密与 HMAC 密钥必须不同，缺失时 fail-closed。
GROWTH_PII_ENCRYPTION_KEYS_JSON=
GROWTH_PII_HMAC_KEYS_JSON=
GROWTH_PII_ACTIVE_ENCRYPTION_KEY_VERSION=0
GROWTH_PII_ACTIVE_HMAC_KEY_VERSION=0
GROWTH_PROJECT_DUAL_WRITE_ENABLED=false
GROWTH_PROJECT_READ_CUTOVER_ENABLED=false
GROWTH_PUBLISH_LANDING_ENABLED=false
GROWTH_EXTERNAL_SEND_ENABLED=false

# 网页发布（模块 18）分享域名 origin，形如 https://share.example.com
# /content 恒带 sandbox 且无 allow-same-origin，制品跑在 opaque origin 里，CSP 的 'self' 永不匹配，
# 必须给显式 host-source——本项就是那个 host。留空则回退请求 origin（nginx 反代后 scheme 会是 http）。
# 配成 API 主域即可工作；配成独立 usercontent 域名才能拿到「主域 cookie 在该域不可见」的隔离，
# 那种情况下必须同时把它加进 CORS_ALLOWED_ORIGINS，并同步官网的 VITE_SHARE_CONTENT_ORIGIN。
WEB_PUBLISH_SHARE_ORIGIN=

# 制品内容域（usercontent 隔离域），形如 https://usercontent.example.cn
# **必须与外壳/API 不同域**：制品在这里才拿得到 allow-same-origin，localStorage/IndexedDB
# 才能用（否则一律 SecurityError）。该域的 nginx 只反代 /s/*，不得暴露 /api/、不得有登录态——
# 它的全部安全价值就是「这个域上没有任何值得偷的东西」。
# 留空则制品退回 opaque origin（无本地存储），这是安全兜底而非故障。
WEB_PUBLISH_CONTENT_ORIGIN=
