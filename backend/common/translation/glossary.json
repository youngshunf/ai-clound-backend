  "forbidden": [
    {
      "pattern": "Huanxing|HuanXing|Huan Xing|HUANXING",
      "reason": "产品名统一为 Astra（命名铁律），历史译文里的 Huanxing/HuanXing 一律替换"
    }
  ],
  "audits": [
    {
      "$comment": "存量译文一次性校正规则：source 命中且 exclude 未命中时，对译文做 replace。",
      "langs": [
        "en"
      ],
      "sourceIncludes": "唤星",
      "from": "Huanxing|HuanXing|Huan Xing",
      "to": "Astra"
    },
    {
      "$comment": "分身 = Agent；头像 = Avatar。两者中文不同、英文历史上混用过，按中文原文区分。",
      "langs": [
        "en"
      ],
      "sourceIncludes": "分身",
      "sourceExcludes": "头像",
      "replacements": [
        {
          "from": "Avatars",
          "to": "Agents"
        },
        {
          "from": "Avatar",
          "to": "Agent"
        },
        {
          "from": "avatars",
          "to": "agents"
        },
        {
          "from": "avatar",
          "to": "agent"
        }
      ]
    }
  ],
  "overrides": {
    "$comment": "P0.5 的 18 组「同中文多英译」人工裁决结果。key 是中文原文，值是各语言选定译法。翻译脚本与一致性门禁都以此为准，防止后续重翻再漂。",
