    },
    "手机号": {
      "en": "Phone",
      "$reason": "存量漂移 Phone number/Phone，统一到 Phone"
    },
    "发布": {
      "en": "Publish",
      "$reason": "动作按钮；状态用「已发布」→Published，中文本就已区分，Published 来自已废弃的 nav.publish.mobile"
    },
    "命令": {
      "en": "Commands",
      "$reason": "权限声明里是命令清单；单数 Command 来自未被引用的死键"
    }
  }
